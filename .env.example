# Copy to .env and fill in. Never commit .env.
# PayPal sandbox credentials: https://developer.paypal.com/dashboard/
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# LLM provider key (our choice of model; sponsors do not supply one)
LLM_API_KEY=

# Elastic serverless project
ELASTIC_URL=
ELASTIC_API_KEY=

# Astropods
ASTROPODS_API_KEY=

# Slack (approval messages), optional
SLACK_WEBHOOK_URL=

# Sandbox account emails (from developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_PERSONAL_EMAIL=

# Where the app runs (used for the PayPal return links)
APP_URL=http://localhost:3000

# Optional: free AI model to polish wording (Google AI Studio key). The app works without it.
GEMINI_API_KEY=
